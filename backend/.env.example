# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://modiq:modiq@localhost:5432/modiq
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
LOG_LEVEL=INFO
# Ixtiyoriy: tavsiyalar sahifasidagi AI xulosasi uchun Google Gemini kaliti (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
