# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://modiq:modiq@localhost:5432/modiq
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
LOG_LEVEL=INFO
# Ixtiyoriy: tavsiyalar sahifasidagi AI xulosasi uchun Google Gemini kaliti (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Vergul bilan bir nechta model: birinchisi band yoki eskirgan bo'lsa, keyingisi sinaladi.
# "Lite" modellar tez (1-2 soniya). Yordamchi va tavsiyalar xulosasi shu modellardan foydalanadi.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Yordamchi: bitta xodim soatiga nechta savol bera oladi.
ASSISTANT_HOURLY_LIMIT=30
