# Serverda: cp .env.prod.example .env.prod  va qiymatlarni o'zgartiring. .env.prod gitga qo'shilmaydi.
# Tasodifiy qiymat olish: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# PostgreSQL (docker-compose.prod.yml ham, backend ham shu qiymatlarni o'qiydi)
POSTGRES_DB=modiq
POSTGRES_USER=modiq
POSTGRES_PASSWORD=change-me

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Serverning ommaviy IP manzili (va domen bo'lsa, u ham), vergul bilan
ALLOWED_HOSTS=1.2.3.4
CSRF_TRUSTED_ORIGINS=http://1.2.3.4
# HTTPS bo'lmasa False (aks holda /admin/ ga kirib bo'lmaydi). HTTPS sozlangach True qiling.
SECURE_COOKIES=False
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
LOG_LEVEL=INFO

# Ixtiyoriy: AI xulosasi va Yordamchi uchun (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite
ASSISTANT_HOURLY_LIMIT=30
